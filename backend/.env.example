DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Leave DB_ENGINE as sqlite3 for local dev, or switch to postgres for production
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional) — leave blank to just print emails to the terminal instead
# of sending them. Fill these in once you have a real email account to send
# from (e.g. a Gmail "app password": https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Synergy Plus Logistics <noreply@synergyplus.com>

# Google Sheets sync (optional) — see the setup guide for how to get these
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=C:\Users\hp\Desktop\synergy-logistics\backend\google-credentials.json
